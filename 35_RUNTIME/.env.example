# v3.8 local product runtime
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8080
DATABASE_URL=postgresql://aiops:aiops@postgres:5432/aiops
AUDIT_LOG=runtime-data/audit.jsonl
RAG_TOP_K=5
MAX_QUERY_CHARS=500
MAX_NOTE_BYTES=100000
