# Prometheus
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_TIMEOUT=5
PROMETHEUS_RATE=2
PROMETHEUS_BURST=4

# Kubernetes (read-only API access)
K8S_API_SERVER=
K8S_BEARER_TOKEN=
K8S_CA_FILE=
K8S_TIMEOUT=5
K8S_RATE=1
K8S_BURST=2

# OTEL Collector
OTEL_COLLECTOR_URL=http://otel-collector:4318

# Connector retries
CONNECTOR_RETRY_ATTEMPTS=3
CONNECTOR_RETRY_BASE_DELAY=0.2
CONNECTOR_RETRY_MAX_DELAY=2
